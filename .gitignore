# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
.venv
__pycache__/

# scout cron logs
services/annex_scout/logs/

# hand-dropped flyers awaiting upload (images stay out of the repo)
flyer-inbox/*
!flyer-inbox/README.md

# Data dumps written by scripts/clean-talent.mjs before it deletes rows.
# Keep them locally so a cleanup is reversible; they are not repo content.
talent-backup-*.json
